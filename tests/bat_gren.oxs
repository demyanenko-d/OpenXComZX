# Гранаты: взвод (ActionMenuState BA_PRIME -> PrimeGrenadeState). Отладочный бой с гранатой в правой
# руке (_bi_dbg = BT_GRENADE), клик по правой руке — меню действий, «Prime Grenade» — окно таймера,
# кнопка «0»: таймер 0 (rounds = 1, запись предмета 0 во второй рабочей странице боя), время бойца
# 60 -> 30 (50 % — units[0].tu #3886). Бросок: боец переставлен на песок (9, 6) (в корабле дуге
# мешает потолок — «Unable to throw here»), меню, «Throw», клетка (9, 10): граната летит по дуге
# и ложится на пол (запись — на земле, BI_GROUND / BI_DROP), время 30 -> 15 (25 %). Таймер 0:
# второй боец переставлен к месту падения (9, 11), конец хода — граната взрывается (вспышка, X1.PCK,
# урон по площади): у бойца 40 -> 15 здоровья (ГСЧ сценария), запись гранаты свободна.
# Снимки — tmp/shots/bat_gren/. Запуск: powershell -File tools\run.ps1 -Script tests\bat_gren.oxs -Headless
waitmark 1 600
poke _alien_off 1
poke _bi_dbg 4
pokew _cursor_x 160
pokew _cursor_y 100
poke _ui_request 248
waitmark 248 900
wait 150
pokew _cursor_x 296
pokew _cursor_y 170
click L
waitmark 250 300
wait 30
shot tmp/shots/bat_gren/0_menu.png
pokew _cursor_x 150
pokew _cursor_y 140
click L
waitmark 255 300
wait 30
shot tmp/shots/bat_gren/1_timer.png
pokew _cursor_x 77
pokew _cursor_y 75
click L
waitmark 248 300
wait 30
shot tmp/shots/bat_gren/2_primed.png
expect *scr_battle$pf_page:6D08 1
expect 4E:3886 30
pokew _cursor_x 296
pokew _cursor_y 170
click L
waitmark 250 300
wait 30
shot tmp/shots/bat_gren/3_menu2.png
poke 4E:3880 9
poke 4E:3881 6
pokew _cursor_x 150
pokew _cursor_y 180
click L
waitmark 248 300
wait 20
pokew _cursor_x 127
pokew _cursor_y 46
wait 10
shot tmp/shots/bat_gren/4_target.png
click L
wait 30
shot tmp/shots/bat_gren/4b_flight.png
wait 50
shot tmp/shots/bat_gren/5_thrown.png
expect *scr_battle$pf_page:6D00 254
expect *scr_battle$pf_page:6D01 254
expect 4E:3886 15
poke 4E:38B0 9
poke 4E:38B1 11
pokew _cursor_x 256
pokew _cursor_y 152
click L
wait 50
shot tmp/shots/bat_gren/6_blast.png
wait 40
shot tmp/shots/bat_gren/7_blast.png
waitmark 249 600
expect 4E:38B8 15
expect *scr_battle$pf_page:6D00 255
exit 0
