# Пришельцы на карте боя (16 §3.3, deploy.c): отладочный бой ставит отряд из шести фигур и
# пришельцев по развёртыванию 0 на узлы маршрутов RMP; клавиша J — камера на пришельца
# (в консоль — «alien N at x,y,z sheet S hp H tu T»).
# Проверка по памяти: units[] логики боя — страница банка 31 (#4E) со смещения #3000, запись
# unit_t — 37 байт, faction — байт 12, sheet — байт 13. Седьмой юнит (номер 6) — пришелец
# (FACTION_HOSTILE = 1) с собранным листом брони (sheet 1).
# Снимок — tmp/shots/bat_aliens/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_aliens.oxs -Headless

waitmark 1 600
poke _alien_off 1
# курсор — в середину экрана: у края окна камера боя едет (прокрутка мышью, как в оригинале)
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
expect 4E:30EA 1
expect 4E:30EB 1
key j
wait 60
shot tmp/shots/bat_aliens/00_alien.png
echo battle aliens OK
exit 0
