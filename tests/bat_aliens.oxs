# Пришельцы на карте боя (16 §3.3, deploy.c) и видимость (16 §5.2, vision.c): отладочный бой
# ставит отряд из шести фигур и пришельцев по развёртыванию 0 на узлы маршрутов RMP. Пришелец
# скрыт, пока его не увидит кто-то из отряда (сектор 90°, дальность 20, линия взгляда по клеткам).
# Клавиша J — камера на пришельца (в консоль — «alien N at x,y,z sheet S hp H tu T»), Shift+J —
# ещё и выбранного бойца к нему: в трёх клетках, лицом к нему, — пришелец должен стать видимым.
# Проверка по памяти: units[] логики боя — страница банка 31 (#4E) со смещения #3000, запись
# unit_t — 48 байт: faction — байт 12, sheet — 13, seen — 34. Седьмой юнит (номер 6, #3120) —
# пришелец (FACTION_HOSTILE = 1) с собранным листом брони (sheet 1), сперва не виден.
# В сценарии CS — Caps Shift (заглавная), SS — Symbol Shift.
# Снимки — tmp/shots/bat_aliens/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_aliens.oxs -Headless

waitmark 1 600
poke _alien_off 1
# курсор — в середину экрана: у края окна камера боя едет (прокрутка мышью, как в оригинале)
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
expect 4E:312C 1
expect 4E:312D 1
expect 4E:3142 0
key j
wait 60
shot tmp/shots/bat_aliens/00_hidden.png
key x
wait 10
key CS+J
wait 60
expect 4E:3142 1
shot tmp/shots/bat_aliens/01_seen.png
echo battle aliens OK
exit 0
