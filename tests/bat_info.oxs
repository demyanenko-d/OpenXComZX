# Окно характеристик бойца (UnitInfoState, bstats.c): клик по показателям на панели (107..270,
# 177..199) — фон UNIBORD.PCK, имя, 18 строк «название — число — полоса»; «>>» — следующий боец,
# клик по окну — закрыть. Снимки — tmp/shots/bat_info/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_info.oxs -Headless

waitmark 1 600
poke _alien_off 1
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
pokew _cursor_x 200
pokew _cursor_y 186
click L
waitmark 252 200
wait 30
shot tmp/shots/bat_info/00_stats.png
pokew _cursor_x 310
pokew _cursor_y 10
click L
wait 40
shot tmp/shots/bat_info/01_next.png
pokew _cursor_x 160
pokew _cursor_y 120
click L
waitmark 248 200
wait 60
shot tmp/shots/bat_info/02_closed.png
echo battle unit info OK
exit 0
