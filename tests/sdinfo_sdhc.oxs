# Карта SDHC (эмулятор: ZC.SDHC=1 — OCR с битом CCS, адрес команд в блоках по 512 байт).
# Без этого эмулятор Unreal даёт только SDSC (байтовая адресация + CMD16), и ветка CT_BLOCK
# драйвера (sd.s set_arg) не выполнялась ни разу, а любая карта от 4 ГБ — SDHC/SDXC.
# Ждём: тип карты 8 (+#03, CT_BLOCK), том FAT32, чтение пачкой = посекторно, 13 пакетов OK;
# главное меню окно диагностики само не открывает. Снимок — tmp/shots/sdinfo/04_sdhc.png.
# Запуск: powershell -File tools\run.ps1 -Script tests\sdinfo_sdhc.oxs -Headless
#@set ZC.SDHC=1

waitmark 1 600
poke _alien_off 1
wait 10
waitmark 1 300
poke _ui_request 14
waitmark 14 600
wait 4
shot tmp/shots/sdinfo/04_sdhc.png
expect 3E:3003 8
expect 3E:300A 1
expect 3E:3010 0
expect 3E:3023 0
expect 3E:3024 0
expect 3E:3029 0
expect 3E:302F 0
key SPACE
waitmark 1 300
echo sdinfo sdhc scenario OK
exit 0
