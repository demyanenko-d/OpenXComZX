# Сокрытие пришельца в его ход (BattlescapeGame::handleAI:204, UnitWalkBState.cpp:197-201): как
# bat_ai.oxs (те же кадры — тот же расход ГСЧ) — боец у пришельца, пришелец его убивает; больше
# никто из отряда пришельца не видит — после выстрела он снова невидим (units[6].seen, #39C2
# страницы #4E = 0) ещё в ход пришельцев и уходит скрытно (units[6].x, #39A0: 3 → 2). Раньше
# прятал только конец хода. Снимки — tmp/shots/bat_hide/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_hide.oxs -Headless
waitmark 1 600
poke _alien_off 1
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
key j
wait 60
key x
wait 10
key CS+J
poke 4E:3898 120
wait 60
poke 4E:39A3 2
shot tmp/shots/bat_hide/00.png
pokew _cursor_x 250
pokew _cursor_y 150
click L
wait 60
shot tmp/shots/bat_hide/01_aliens.png
expect 4E:39C2 1
click L
wait 4
shot tmp/shots/bat_hide/02.png
wait 4
shot tmp/shots/bat_hide/03.png
wait 4
shot tmp/shots/bat_hide/04.png
wait 4
shot tmp/shots/bat_hide/05.png
wait 4
shot tmp/shots/bat_hide/06.png
wait 4
shot tmp/shots/bat_hide/07.png
wait 50
expect 4E:3888 0
wait 10
expect 4E:39C2 0
expect 4E:39A0 3
wait 30
shot tmp/shots/bat_hide/08_hidden.png
expect 4E:39C2 0
expect 4E:39A0 2
exit 0
