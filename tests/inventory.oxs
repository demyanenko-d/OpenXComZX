# Автотест инвентаря бойца (InventoryState, TFTD): экран из снаряжения корабля — кукла, сетка
# секций, груз корабля на «земле» (стопки с числами). Взять предмет с земли и положить в правую
# руку, зарядить его обоймой с земли, навести курсор (подпись, обойма и «патронов осталось»),
# разрядить взятое оружие (обойма — в левую руку, оружие — в правую), отменить взятие правой
# кнопкой. Все исследования открыты (discovered, #006E, 20 байт) — имена предметов, не «артефакт».
# Снимки — tmp/shots/inv/.
# Запуск: powershell -File tools\run.ps1 -Script tests\inventory.oxs -Headless

waitmark 1 600
poke _alien_off 1
pokew _cursor_x 110
pokew _cursor_y 100
click L
waitmark 2 300
pokew _cursor_x 119
pokew _cursor_y 172
click L
waitmark 43 600
pokew _cursor_x 120
pokew _cursor_y 110
click L
waitmark 42 300
type deep
key ENTER
waitmark 32 300
pokew 06:006E 0xFFFF
pokew 06:0070 0xFFFF
pokew 06:0072 0xFFFF
pokew 06:0074 0xFFFF
pokew 06:0076 0xFFFF
pokew 06:0078 0xFFFF
pokew 06:007A 0xFFFF
pokew 06:007C 0xFFFF
pokew 06:007E 0xFFFF
poke _ctx+1 0
poke _ui_request 198
waitmark 198 600
wait 30
shot tmp/shots/inv/01.png
# взять дротикомёт с земли: он идёт за курсором (по центру рамки 2x3)
pokew _cursor_x 8
pokew _cursor_y 160
click L
wait 10
pokew _cursor_x 60
pokew _cursor_y 100
wait 10
shot tmp/shots/inv/02_carry.png
# положить в правую руку: клетка — под левой верхней клеткой предмета
pokew _cursor_x 16
pokew _cursor_y 80
click L
wait 10
shot tmp/shots/inv/03_hand.png
# обойму с земли — в оружие в руке (зарядка), курсор на оружии: подпись, обойма, патроны
pokew _cursor_x 8
pokew _cursor_y 184
click L
wait 10
pokew _cursor_x 16
pokew _cursor_y 80
click L
wait 10
pokew _cursor_x 20
pokew _cursor_y 90
wait 10
shot tmp/shots/inv/04_loaded.png
# взять оружие и разрядить (unload): обойма — в левую руку, оружие — в правую
click L
wait 10
pokew _cursor_x 300
pokew _cursor_y 44
click L
wait 10
shot tmp/shots/inv/05_unloaded.png
# взять газовую пушку с земли и вернуть правой кнопкой
pokew _cursor_x 24
pokew _cursor_y 160
click L
wait 10
pokew _cursor_x 200
pokew _cursor_y 120
wait 10
click R
wait 10
shot tmp/shots/inv/06_cancel.png
echo inventory scenario OK
exit 0
