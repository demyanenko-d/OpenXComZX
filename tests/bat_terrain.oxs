# Разрушение местности взрывом (TileEngine::detonate, Tile::destroy; bexpl.c): отладочный бой с гранатой
# (_bi_dbg 4), взвод на 0, запись гранаты (0, вторая рабочая страница #2D00) — на землю у корабля
# (9, 15, 0), конец хода — взрыв: части с 2 · броня ≤ мощности луча в клетке сносятся, на их место —
# Die_MCD (песок выжжен), стены корабля (броня выше) целы. Клеток с разрушениями — счётчик ex_ndet
# памяти банка 39 (#8D:3930). Снимки — tmp/shots/bat_terrain/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_terrain.oxs -Headless
waitmark 1 600
poke _alien_off 1
poke _bi_dbg 4
pokew _cursor_x 160
pokew _cursor_y 100
poke _ui_request 248
waitmark 248 900
wait 150
pokew _cursor_x 296
pokew _cursor_y 170
click L
waitmark 250 300
wait 30
pokew _cursor_x 150
pokew _cursor_y 140
click L
waitmark 255 300
wait 30
pokew _cursor_x 77
pokew _cursor_y 75
click L
waitmark 248 300
wait 30
poke *scr_battle$pf_page:6D00 254
poke *scr_battle$pf_page:6D01 254
poke *scr_battle$pf_page:6D02 9
poke *scr_battle$pf_page:6D03 15
poke *scr_battle$pf_page:6D09 0
shot tmp/shots/bat_terrain/0_before.png
pokew _cursor_x 256
pokew _cursor_y 152
click L
waitmark 249 900
peek 8D:3930 1
expect 8D:3930 52
key ENTER
waitmark 249 3000
key ENTER
waitmark 248 300
wait 30
shot tmp/shots/bat_terrain/1_after.png
exit 0
