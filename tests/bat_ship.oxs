# Поле 70x70 (судно TFTD, развёртывание 10: суда — 3x7 модулей, поле квадратное): поиск пути
# в окне 64x64 вокруг начала и цели (pathfind.c pf_ox/pf_oy). Раньше поле шире 64 он отвергал —
# никто не ходил. Боец (14,2) шагает на восток; в ход пришельцев патрульные идут по 4 клетки,
# в том числе от (31,41) и (41,21) — окно сдвинуто по y и по x. Проверка — клетки units[0],
# units[6], [7], [8] (#3880, #39A0, #39D0, #3A00 страницы #4E; ГСЧ сценария воспроизводим).
# Снимки — tmp/shots/bat_ship/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_ship.oxs -Headless
waitmark 1 600
poke _alien_off 1
pokew _cursor_x 160
pokew _cursor_y 100
poke _ui_request 248
waitmark 248 900
wait 150
pokew scr_battle$mis_deploy 10
key g
wait 900
expect 4E:3880 14
expect 4E:3881 2
expect 4E:3A00 31
expect 4E:3A01 41
shot tmp/shots/bat_ship/00.png
pokew _cursor_x 192
pokew _cursor_y 104
wait 5
click L
wait 90
expect 4E:3880 15
expect 4E:3881 2
pokew _cursor_x 250
pokew _cursor_y 150
click L
wait 60
click L
wait 1500
shot tmp/shots/bat_ship/01.png
expect 4E:39A1 5
expect 4E:39D0 41
expect 4E:39D1 25
expect 4E:3A00 31
expect 4E:3A01 45
exit 0
