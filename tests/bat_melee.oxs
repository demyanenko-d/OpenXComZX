# Удар бойца (ActionMenuState:306 -> MeleeAttackBState): у отряда оружие ближнего боя (_bi_dbg 3 —
# первое BT_MELEE, оглушающее, правило #30); боец в (4,34) вплотную к пришельцу (3,34) лицом к нему
# (dir 6), у пришельца нет времени (не ответит). Меню правой руки — «Stun» (точность — accuracyMelee
# без навыка: skillApplied нет), выбор — удар сразу в клетку перед бойцом: время 60 -> 36, пришелец
# оглушён (units[6].stun, #39B1 = 52 >= здоровья 30 — выбыл, #39A4 = 0). Снимки — tmp/shots/bat_melee/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_melee.oxs -Headless
waitmark 1 600
poke _alien_off 1
poke _bi_dbg 3
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
key j
wait 60
key x
wait 10
key CS+J
wait 60
poke 4E:3880 4
poke 4E:3881 34
poke 4E:3883 6
poke 4E:39A6 0
key c
wait 60
expect D1:2D04 48
pokew _cursor_x 296
pokew _cursor_y 172
click L
waitmark 250 200
wait 30
shot tmp/shots/bat_melee/00_menu.png
pokew _cursor_x 160
pokew _cursor_y 140
click L
wait 60
shot tmp/shots/bat_melee/01_after.png
expect 4E:3886 36
expect 4E:39B1 52
expect 4E:39A4 0
# опыт рукопашной бойца 0 (BA_XP + EXP_MELEE — #3102 страницы #EE)
expect EE:3102 1
exit 0
