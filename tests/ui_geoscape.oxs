# перехват (отладочный бой: корабль с оружием против подставного НЛО у базы):
# режим кнопкой, сближение, отход — бой кончается за 640, окно закрывается
poke _ui_request 216
waitmark 216 300
shot tmp/shots/ui/54_dogfight.png
key 4
wait 150
shot tmp/shots/ui/55_dogfight_aggressive.png
key 5
waitmark 32 900

# --- выход в главное меню, отладочный список окон, выход
key SPACE
waitmark 5 300
pokew _cursor_x 128
pokew _cursor_y 105
click L
waitmark 6 300
key ENTER
waitmark 1 300
key D
waitmark 11 300
shot tmp/shots/ui/60_debug_list.png
pokew _cursor_x 100
pokew _cursor_y 52
click L
waitmark 202 300
shot tmp/shots/ui/61_debug_open.png
key SPACE
waitmark 11 300
key SPACE
waitmark 1 300
echo ui_geoscape scenario OK
pokew _cursor_x 210
pokew _cursor_y 128
click L
wait 20
exit 1
