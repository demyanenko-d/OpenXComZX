# Автотест интерфейса: главное меню -> новая игра -> первая база -> геоскейп и
# все его окна. Данные — состояние кампании (state.h); окна, для которых ещё нет
# логики (НЛО, миссии, бой), открываются запросом poke _ui_request <номер>
# (src/common/screens.h) и показывают отладочные данные. Клики — курсор прямо в
# экранные координаты (pokew _cursor_x/_cursor_y) + click L; экран сообщает
# свой номер в #FCAF (waitmark). Экономика и сохранения — tests/campaign.oxs.
# Запуск: powershell -File tools\run.ps1 -Script tests\ui_geoscape.oxs -Headless
# Снимки экранов — отдельная папка tmp/shots/ui/ (NN_имя.png, по порядку прохода).

waitmark 1 600
# пришельцы не начинают миссий (их проверяет aliens.oxs); окна НЛО — подставные
poke _alien_off 1
shot tmp/shots/ui/01_main.png

# --- новая игра: сложность (радиогруппа), ironman (переключатель), OK
pokew _cursor_x 110
pokew _cursor_y 100
click L
waitmark 2 300
pokew _cursor_x 160
pokew _cursor_y 81
click L
waitmark 2 100
pokew _cursor_x 119
pokew _cursor_y 147
click L
waitmark 2 100
shot tmp/shots/ui/02_newgame.png
# Ironman обратно выключить (иначе сразу после базы — обязательный слот, tests/ironman.oxs)
pokew _cursor_y 147
click L
waitmark 2 100
pokew _cursor_x 119
pokew _cursor_y 172
click L

# --- первая база: место на глобусе -> имя (ввод с клавиатуры) -> геоскейп
waitmark 43 600
shot tmp/shots/ui/03_first_base.png
pokew _cursor_x 120
pokew _cursor_y 110
click L
waitmark 42 300
type atlantis
wait 10
shot tmp/shots/ui/04_base_name.png
key ENTER
waitmark 32 300
shot tmp/shots/ui/05_geoscape.png

# --- скорость времени: клавиша 3 (5 минут), часы идут
key 3
wait 60
shot tmp/shots/ui/06_geo_speed.png
key 1
waitmark 32 100

# --- перехват: корабль базы -> выбор цели (новая путевая точка) -> подтверждение ->
# корабль вылетает (взлёт 5 минут игры, потом к точке)
pokew _cursor_x 288
pokew _cursor_y 5
click L
waitmark 200 300
shot tmp/shots/ui/07_intercept.png
pokew _cursor_x 50
pokew _cursor_y 81
click L
waitmark 49 300
shot tmp/shots/ui/08_select_dest.png
pokew _cursor_x 128
pokew _cursor_y 120
click L
waitmark 203 300
shot tmp/shots/ui/09_confirm_dest.png
pokew _cursor_x 93
pokew _cursor_y 110
click L
waitmark 32 300

# --- база на глобусе (центр): там же взлетающий корабль — MultipleTargets (база, корабль);
# база -> перехват с базы (её корабли, «Go to base») -> Basescape
pokew _cursor_x 128
pokew _cursor_y 100
click L
waitmark 207 300
shot tmp/shots/ui/09b_multi_targets.png
pokew _cursor_y 90
click L
waitmark 200 300
shot tmp/shots/ui/09a_intercept_base.png
pokew _cursor_x 230
pokew _cursor_y 154
click L
waitmark 96 300
shot tmp/shots/ui/10_basescape.png
key SPACE
waitmark 32 300

# --- окна целей на глобусе (НЛО — отладочное)
poke _ui_request 36
waitmark 36 300
shot tmp/shots/ui/11_ufo_detected.png
key SPACE
waitmark 32 300
poke _ui_request 201
waitmark 201 300
shot tmp/shots/ui/12_geo_craft.png
key SPACE
waitmark 32 300
poke _ui_request 202
waitmark 202 300
shot tmp/shots/ui/13_target_info.png
key SPACE
waitmark 32 300
poke _ui_request 207
waitmark 207 300
shot tmp/shots/ui/14_multi_targets.png
pokew _cursor_x 128
pokew _cursor_y 80
click L
waitmark 201 300
key SPACE
waitmark 32 300
poke _ui_request 206
waitmark 206 300
shot tmp/shots/ui/15_craft_error.png
key SPACE
waitmark 32 300

# --- базы: кнопка панели -> Basescape
key B
waitmark 96 300
key SPACE
waitmark 32 300

# --- графики: переключатель региона, режимы
key G
waitmark 240 300
