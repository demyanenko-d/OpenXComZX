waitmark 32 300

# --- Уфопедия: раздел, прокрутка, статья
key U
waitmark 9 300
shot tmp/shots/ui/19_ufopaedia.png
pokew _cursor_x 160
pokew _cursor_y 82
click L
waitmark 10 300
shot tmp/shots/ui/20_ufop_select.png
pokew _cursor_x 274
pokew _cursor_y 147
click L
waitmark 10 100
click L
waitmark 10 100
shot tmp/shots/ui/21_ufop_scrolled.png
pokew _cursor_x 152
pokew _cursor_y 54
click L
waitmark 224 900
shot tmp/shots/ui/22_ufop_article.png
key SPACE
waitmark 10 300
key SPACE
waitmark 9 300
key SPACE
waitmark 32 300

# --- финансы
key F
waitmark 39 300
shot tmp/shots/ui/23_funding.png
key SPACE
waitmark 32 300

# --- опции геоскейпа: сохранить (окно имени, отмена), загрузить, свои опции, выход из игры
key SPACE
waitmark 5 300
shot tmp/shots/ui/24_pause.png
pokew _cursor_x 128
pokew _cursor_y 83
click L
waitmark 4 300
shot tmp/shots/ui/25_save.png
pokew _cursor_x 100
pokew _cursor_y 62
click L
waitmark 107 300
shot tmp/shots/ui/26_save_name.png
key BREAK
waitmark 4 300
key SPACE
waitmark 5 300
pokew _cursor_x 128
pokew _cursor_y 61
click L
waitmark 3 300
shot tmp/shots/ui/27_load.png
# правый клик по занятому слоту — подтверждение удаления (No)
pokew _cursor_x 100
pokew _cursor_y 53
click R
waitmark 13 300
shot tmp/shots/ui/27a_delete_save.png
key SPACE
waitmark 3 300
key SPACE
waitmark 5 300
pokew _cursor_x 128
pokew _cursor_y 131
click L
waitmark 8 300
pokew _cursor_x 102
pokew _cursor_y 85
click L
waitmark 8 100
shot tmp/shots/ui/28_options.png
key SPACE
waitmark 5 300
pokew _cursor_x 128
pokew _cursor_y 105
click L
waitmark 6 300
shot tmp/shots/ui/29_abandon.png
pokew _cursor_x 193
pokew _cursor_y 150
click L
waitmark 5 300
key SPACE
waitmark 32 300

# --- окна событий геоскейпа по запросу
poke _ui_request 37
waitmark 37 300
shot tmp/shots/ui/30_ufo_lost.png
key SPACE
waitmark 32 300
