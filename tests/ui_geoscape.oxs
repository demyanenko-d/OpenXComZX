# пси-тренировка: базы с пси-лабораторией (у стартовой нет) и список солдат
# базы (вместимость 0 — отметить нельзя)
poke _ui_request 74
waitmark 74 300
shot tmp/shots/ui/50_psi_training.png
key SPACE
waitmark 32 300
