# Диагностика SD при отказе DMA SPI->RAM (эмулятор: «fault dmaspi 1» — байты с карты
# читаются, но в память не пишутся). Так выглядела бы машина без этого канала: том и каталоги
# читаются посекторно (CMD17 + INIR) и находятся, а ресурсы пачкой (CMD18 + DMA) — пустые;
# у игры пропадают заставка, фоны окон и музыка. Главное меню само открывает окно
# диагностики (SCR_SDINFO = 14): read test — MISMATCH (+#10 = 1), пакеты при этом — OK.
# После «fault dmaspi 0» и RETRY — снова норма. Снимки — tmp/shots/sdinfo/.
# Запуск: powershell -File tools\run.ps1 -Script tests\sdinfo_dma.oxs -Headless

fault dmaspi 1
waitmark 14 900
poke _alien_off 1
wait 4
shot tmp/shots/sdinfo/02_dma_fault.png
expect 3E:3010 1
expect 3E:3011 0
expect 3E:3023 0
expect 3E:302F 0
fault dmaspi 0
key R
waitmark 14 600
wait 4
shot tmp/shots/sdinfo/03_dma_back.png
expect 3E:3010 0
key SPACE
waitmark 1 300
echo sdinfo dma scenario OK
exit 0
