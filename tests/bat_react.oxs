# Огонь в ответ (TileEngine::checkReactionFire, bai.c ai_react): боец у пришельца (как в
# bat_fire.oxs), пришелец развёрнут к нему (units[6].dir, #39A3 = 2); боец стреляет навскидку —
# пришелец видит стрелявшего, его очки реакции (63 · 54/54) больше бойцовых (50 · 48/60): ответ
# навскидку (время 54 -> 38, #39A6) убивает бойца (units[0].hp, #3888 = 0).
# Снимки — tmp/shots/bat_react/. Запуск: powershell -File tools\run.ps1 -Script tests\bat_react.oxs -Headless
waitmark 1 600
poke _alien_off 1
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
key j
wait 60
key x
wait 10
key CS+J
poke 4E:3898 120
poke 4E:39A3 2
wait 60
shot tmp/shots/bat_react/00_seen.png
# правая рука -> навскидку -> клик по пришельцу (середина экрана)
pokew _cursor_x 296
pokew _cursor_y 172
click L
waitmark 250 200
wait 30
pokew _cursor_x 160
pokew _cursor_y 135
click L
waitmark 248 200
wait 40
pokew _cursor_x 176
pokew _cursor_y 96
wait 20
shot tmp/shots/bat_react/01_aim.png
click L
wait 60
shot tmp/shots/bat_react/02_after.png
wait 300
expect 4E:3888 0
expect 4E:39A6 38
exit 0
