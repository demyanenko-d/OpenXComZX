# Выстрел (bfire.c, ProjectileFlyBState / Projectile / TileEngine::hit): боец у пришельца (Shift+J),
# меню правой руки — «Snap Shot», клик по пришельцу — прицел; четыре выстрела по 12 единиц времени
# (60 -> 12); меткость бойца поднята до 120 (units[0].firing, #3898) — часть пуль всё равно в кораллы:
# здоровье пришельца 30 -> 18 (ГСЧ сценария
# воспроизводим; меняется расход случайных чисел — поправить ожидание).
# units[0].tu — #3886, units[6].hp — #39A8 (страница банка 31 #4E). Снимки — tmp/shots/bat_fire/.
# Запуск: powershell -File tools\run.ps1 -Script tests\bat_fire.oxs -Headless

waitmark 1 600
poke _alien_off 1
pokew _cursor_x 160
pokew _cursor_y 100
poke _bat_still 1
poke _ui_request 248
waitmark 248 900
wait 150
key j
wait 60
key x
wait 10
key CS+J
poke 4E:3898 120
wait 60
shot tmp/shots/bat_fire/00_seen.png
# правая рука -> навскидку -> клик по пришельцу (середина экрана)
pokew _cursor_x 296
pokew _cursor_y 172
click L
waitmark 250 200
wait 30
pokew _cursor_x 160
pokew _cursor_y 135
click L
waitmark 248 200
wait 40
pokew _cursor_x 176
pokew _cursor_y 96
wait 20
shot tmp/shots/bat_fire/01_aim.png
click L
wait 60
shot tmp/shots/bat_fire/02_after.png
pokew _cursor_x 296
pokew _cursor_y 172
click L
waitmark 250 200
wait 30
pokew _cursor_x 160
pokew _cursor_y 135
click L
waitmark 248 200
wait 40
pokew _cursor_x 176
pokew _cursor_y 96
wait 20
click L
wait 60
pokew _cursor_x 296
pokew _cursor_y 172
click L
waitmark 250 200
wait 30
pokew _cursor_x 160
pokew _cursor_y 135
click L
waitmark 248 200
wait 40
pokew _cursor_x 176
pokew _cursor_y 96
wait 20
click L
wait 60
pokew _cursor_x 296
pokew _cursor_y 172
click L
waitmark 250 200
wait 30
pokew _cursor_x 160
pokew _cursor_y 135
click L
waitmark 248 200
wait 40
pokew _cursor_x 176
pokew _cursor_y 96
wait 20
click L
wait 60
shot tmp/shots/bat_fire/03_more.png
expect 4E:39A8 18
expect 4E:3886 12
echo battle fire OK
exit 0
