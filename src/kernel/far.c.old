// Дальняя память и копирование DMA (общий код).
#include <stdint.h>
#include <string.h>
#include "tsconf.h"
#include "memmap.h"
#include "pages.h"
#include "far.h"

void far_read(far_t src, void *dst, uint16_t len)
{
	uint8_t old = pg_win3();
	uint8_t page = FAR_PAGE(src);
	uint16_t off = FAR_OFFS(src);
	uint8_t *d = (uint8_t *)dst;
	while (len) {
		uint16_t n = 0x4000 - off;
		if (n > len) n = len;
		pg_map3(page);
		memcpy(d, (const uint8_t *)(0xC000 + off), n);
		d += n;
		len -= n;
		off = 0;
		page++;
	}
	pg_map3(old);
}

void far_write(far_t dst, const void *src, uint16_t len)
{
	uint8_t old = pg_win3();
	uint8_t page = FAR_PAGE(dst);
	uint16_t off = FAR_OFFS(dst);
	const uint8_t *s = (const uint8_t *)src;
	while (len) {
		uint16_t n = 0x4000 - off;
		if (n > len) n = len;
		pg_map3(page);
		memcpy((uint8_t *)(0xC000 + off), s, n);
		s += n;
		len -= n;
		off = 0;
		page++;
	}
	pg_map3(old);
}

void far_fill(far_t dst, uint8_t v, uint16_t len)
{
	uint8_t old = pg_win3();
	uint8_t page = FAR_PAGE(dst);
	uint16_t off = FAR_OFFS(dst);
	while (len) {
		uint16_t n = 0x4000 - off;
		if (n > len) n = len;
		pg_map3(page);
		memset((uint8_t *)(0xC000 + off), v, n);
		len -= n;
		off = 0;
		page++;
	}
	pg_map3(old);
}

uint8_t far_byte(far_t src)
{
	uint8_t v;
	far_read(src, &v, 1);
	return v;
}

uint16_t far_word(far_t src)
{
	uint16_t v;
	far_read(src, &v, 2);
	return v;
}

far_t near_phys(const void *p)
{
	uint16_t a = (uint16_t)p;
	return FAR((a & 0x4000) ? DATA_PAGE : KERNEL_PAGE, a & 0x3FFF);
}

static void dma_wait(void)
{
	while (TS_DMASTATUS & DMASTATUS_ACT)
		;
}

void far_copy(far_t dst, far_t src, uint32_t len)
{
	len = (len + 1) & ~1ul;
	while (len) {
		// до 256 пачек по 512 байт (128 КБ) за запуск
		uint32_t chunk = len > 0x20000ul ? 0x20000ul : len;
		uint16_t words = (uint16_t)(chunk >> 1);
		uint16_t bursts, blen;
		if (words >= 256) { blen = 256; bursts = words >> 8; }
		else { blen = words; bursts = 1; }
		dma_wait();
		TS_DMASAL = (uint8_t)src; TS_DMASAH = (uint8_t)(src >> 8) & 0x3F; TS_DMASAX = FAR_PAGE(src);
		TS_DMADAL = (uint8_t)dst; TS_DMADAH = (uint8_t)(dst >> 8) & 0x3F; TS_DMADAX = FAR_PAGE(dst);
		TS_DMALEN = (uint8_t)(blen - 1);
		TS_DMANUM = (uint8_t)(bursts - 1);
		TS_DMACTRL = DMA_RAM_RAM;
		dma_wait();
		uint32_t done = (uint32_t)blen * bursts * 2;
		src += done; dst += done; len -= done;
	}
}
