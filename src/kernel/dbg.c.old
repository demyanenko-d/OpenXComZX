// Отладочный вывод в консоль эмулятора (общий код).
#include <stdint.h>
#include "tsconf.h"
#include "dbg.h"

void dbg_puts(const char *s)
{
	while (*s)
		OXZ_DBG_CHAR = *s++;
}

void dbg_dec(uint32_t v)
{
	char buf[11];
	uint8_t i = sizeof buf - 1;
	buf[i] = 0;
	do {
		buf[--i] = '0' + (uint8_t)(v % 10);
		v /= 10;
	} while (v);
	dbg_puts(&buf[i]);
}

void dbg_hex8(uint8_t v)
{
	OXZ_DBG_HEX = v;
}
