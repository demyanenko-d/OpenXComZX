// Ввод, резидентная часть (Win0): кадровое прерывание защёлкивает нажатия кнопок
// мыши и клавиш, пока их не заберёт input_poll (cursor.c, банк 11) — долгая
// перерисовка между опросами их не теряет. Кандидат на ассемблер (14_todo.md §1.3).
#include <stdint.h>
#include "tsconf.h"
#include "input.h"

uint8_t in_prev_btn, in_prev_keys;       // состояние прошлого кадра (ISR)
volatile uint8_t in_btn_latch, in_key_latch;   // нажатия до опроса

// Матрица ZX: полуряды #FEFE..#7FFE, биты 0..4. CAPS SHIFT и SYMBOL SHIFT —
// модификаторы: CS+буква — заглавная, CS+0 — KEY_DEL, CS+SPACE (BREAK) —
// KEY_ESC; просто SPACE — KEY_SPACE (вне поля ввода интерфейс считает его ESC).
static const char keymap[8][5] = {
	{ 0, 'z', 'x', 'c', 'v' }, { 'a', 's', 'd', 'f', 'g' }, { 'q', 'w', 'e', 'r', 't' },
	{ '1', '2', '3', '4', '5' }, { '0', '9', '8', '7', '6' }, { 'p', 'o', 'i', 'u', 'y' },
	{ KEY_ENTER, 'l', 'k', 'j', 'h' }, { KEY_SPACE, 0, 'm', 'n', 'b' },
};

// Первая нажатая клавиша (код из keymap с учётом CAPS SHIFT) или 0.
static uint8_t read_key(void)
{
	uint8_t rows[8];
	rows[0] = KBD_CS_V; rows[1] = KBD_A_G; rows[2] = KBD_Q_T; rows[3] = KBD_1_5;
	rows[4] = KBD_0_6; rows[5] = KBD_P_Y; rows[6] = KBD_EN_H; rows[7] = KBD_SP_B;
	uint8_t cs = !(rows[0] & 1);
	for (uint8_t r = 0; r < 8; r++) {
		uint8_t v = ~rows[r] & 0x1F;
		for (uint8_t b = 0; v; b++, v >>= 1)
			if ((v & 1) && keymap[r][b]) {
				uint8_t k = (uint8_t)keymap[r][b];
				if (!cs) return k;
				if (k == KEY_SPACE) return KEY_ESC;
				if (k == '0') return KEY_DEL;
				if (k >= 'a' && k <= 'z') return k - 32;
				return k;
			}
	}
	return 0;
}

void input_isr(void)
{
	uint8_t b = ~KMOUSE_BTN & 3;
	uint8_t old = in_prev_btn;
	in_btn_latch |= b & ~old;
	in_prev_btn = b;
	// SDCC 4.5 (#15242): «k != prev_keys» с k в A компилируется в sub a,(hl), а
	// дальше A используется как k. Обход — сравнивать с локальной копией
	// (tools/checkasm.js ищет такие места при сборке; 01_environment.md).
	uint8_t k = read_key();
	uint8_t p = in_prev_keys;
	if (k != p) {
		in_prev_keys = k;
		if (k) in_key_latch = k;
	}
}
