// Шрифты и строки (общий код).
// Шрифты при запуске копируются в свою страницу пула; при рисовании она подключается
// в Win2 (банк вызывающего потом восстанавливается), экран — через Win3.
// Пиксель глифа — уровень 0..5; цвет = color + уровень*mul (+ инверсия), как
// PaletteShift в OpenXcom Text::draw.
#include <stdint.h>
#include <string.h>
#include "tsconf.h"
#include "memmap.h"
#include "pages.h"
#include "far.h"
#include "res.h"
#include "res_ids.h"
#include "gfx.h"
#include "text.h"

extern uint8_t get_bank(void);
extern void set_bank(uint8_t bank);

static uint8_t font_page;                 // страница со всеми шрифтами
static uint16_t font_off[4];              // смещение шрифта в странице
static uint8_t font_cw[4], font_ch[4];
static int8_t font_sp[4];
static far_t str_base;                    // ресурс STRINGS
static uint16_t str_n;
static char strbuf[1024];

void text_init(void)
{
	static const uint16_t ids[4] = { RES_FONT_BIG, RES_FONT_SMALL, RES_FONT_GEO_BIG, RES_FONT_GEO_SMALL };
	res_t r;
	uint16_t off = 0;
	font_page = pg_alloc(1, 1);
	for (uint8_t i = 0; i < 4; i++) {
		if (!res_find(ids[i], &r)) continue;
		font_off[i] = off;
		far_copy(FAR(font_page, off), r.phys, r.size);
		uint8_t h[3];
		far_read(r.phys, h, 3);
		font_cw[i] = h[0]; font_ch[i] = h[1]; font_sp[i] = (int8_t)h[2];
		off += (uint16_t)((r.size + 1) & ~1ul);
	}
	if (res_find(RES_STRINGS, &r)) {
		str_base = r.phys;
		str_n = far_word(r.phys);
	}
}

uint8_t font_height(uint8_t f) { return font_ch[f] + font_sp[f]; }

// --- строки

void str_copy(uint16_t id, char *dst, uint16_t max)
{
	uint8_t e[3];
	if (id >= str_n) goto missing;
	far_read(str_base + 2 + (uint32_t)id * 3, e, 3);
	if (e[0] == 0xFF && e[1] == 0xFF && e[2] == 0xFF) goto missing;
	{
		far_t p = str_base + 2 + (uint32_t)str_n * 3 + (e[0] | ((uint32_t)e[1] << 8) | ((uint32_t)e[2] << 16));
		uint16_t n = 0;
		while (n + 1 < max) {
			uint16_t k = max - 1 - n;
			if (k > 64) k = 64;
			far_read(p, dst + n, k);
			uint16_t z = 0;
			while (z < k && dst[n + z]) z++;
			if (z < k) { n += z; break; }
			n += k; p += k;
		}
		dst[n] = 0;
		return;
	}
missing:
	dst[0] = '#';
	fmt_num(dst + 1, id, 0);
}

const char *str_get(uint16_t id)
{
	str_copy(id, strbuf, sizeof strbuf);
	return strbuf;
}

// Вычитанием степеней 10: 32-битное деление SDCC на Z80 — тысячи тактов на цифру.
static const uint32_t pow10[9] = {
	1000000000ul, 100000000ul, 10000000ul, 1000000ul, 100000ul, 10000ul, 1000ul, 100ul, 10ul,
};

char *fmt_num(char *out, int32_t v, char sep)
{
	char *o = out;
	uint32_t u = (uint32_t)v;
	uint8_t started = 0;
	if (v < 0) { *o++ = '-'; u = (uint32_t)-v; }
	for (uint8_t i = 0; i < 9; i++) {
		uint32_t p = pow10[i];
		char d = '0';
		while (u >= p) { u -= p; d++; }
		if (d != '0' || started) {
			*o++ = d;
			started = 1;
			if (sep && (i == 0 || i == 3 || i == 6)) *o++ = sep;   // осталось 9, 6, 3 цифры
		}
	}
	*o++ = '0' + (char)u;
	*o = 0;
	return out;
}

void str_fmt(char *out, const char *pat, const char *a0, const char *a1)
{
	char *o = out;
	for (; *pat && o < out + 255; pat++) {
		const char *a = *pat == 0x10 || *pat == 0x03 ? a0 : *pat == 0x11 ? a1 : 0;
		if (a) { while (*a && o < out + 255) *o++ = *a++; }
		else *o++ = *pat;
	}
	*o = 0;
}

// Language::getString(id, n): форма «one» (id) для 1, иначе «other» (id + 1); {N} — n
void str_plural(char *out, uint16_t one, int32_t n)
{
	char num[12];
	fmt_num(num, n, 0);
	str_fmt(out, str_get(n == 1 ? one : one + 1), num, "");
}

// --- глифы (шрифт подключён в Win2: данные по адресу #8000 + font_off)

static const uint8_t *fbase;

static uint8_t glyph_index(uint8_t c)
{
	return c >= 0x80 ? (uint8_t)(c - 0x80 + 95) : (uint8_t)(c - 0x20);
}

static uint8_t glyph_w(uint8_t c)
{
	return fbase[6 + glyph_index(c) * 3];
}

static int16_t char_adv(uint8_t f, uint8_t c)
{
	if (c == ' ') return font_cw[f] >> 1;
	if (c == 0x04) return font_cw[f] >> 2;
	if (c < 0x20) return 0;
	return glyph_w(c) + font_sp[f];
}

static void map_font(uint8_t f)
{
	TS_PAGE2 = font_page;
	fbase = (const uint8_t *)(0x8000 + font_off[f]);
}

int16_t text_width(uint8_t f, const char *s)
{
	uint8_t bank = get_bank();
	map_font(f);
	int16_t w = 0;
	for (; *s && *s != '\n' && *s != 0x02; s++) w += char_adv(f, (uint8_t)*s);
	set_bank(bank);
	return w;
}

// Цвет пикселя по уровню глифа: color + v*mul (+ 2*(mid - v) при инверсии).
static uint8_t lut[16];

// src/kernel/win0/glyph.s: строки глифа в одной странице экрана (быстрый путь)
extern uint8_t *gr_dst;
extern const uint8_t *gr_src;
extern uint8_t gr_bpr, gr_rows, gr_col, gr_inv;
void glyph_run(void);
static uint8_t lut_mul, lut_mid, lut_ok;

// Цвет текста; таблица lut нужна только медленному пути — строится при первом обращении.
static void set_lut(uint8_t color, uint8_t mul, uint8_t mid)
{
	gr_col = color;
	gr_inv = mid ? 1 : 0;
	lut_mul = mul;
	lut_mid = mid;
	lut_ok = 0;
}

static void make_lut(void)
{
	for (uint8_t v = 1; v < 16; v++)
		lut[v] = (uint8_t)(gr_col + v * lut_mul + (lut_mid ? 2 * (lut_mid - v) : 0));
	lut_ok = 1;
}

// Глиф: 4 бита на пиксель, строка — (w+1)/2 байт. Целиком в рамке и на экране —
// ассемблерный цикл по строкам (glyph_run), иначе — по пикселям с отсечением.
static void draw_glyph(uint8_t c, int16_t x, int16_t y, const tbox_t *b)
{
	const uint8_t *e = fbase + 6 + glyph_index(c) * 3;
	uint8_t w = e[0];
	const uint8_t *g = fbase + 6 + fbase[4] * 3 + (e[1] | (e[2] << 8));
	uint8_t bpr = (w + 1) >> 1, h = fbase[1];
	if (lut_mul == 1 && x >= b->x && x + w <= b->x + b->w && x >= 0 && x + w <= SCREEN_W
	    && y >= b->y && y + h <= b->y + b->h && y >= 0 && y + h <= SCREEN_H) {
		gr_src = g;
		gr_bpr = bpr;
		while (h) {
			uint8_t n = 32 - ((uint8_t)y & 31);
			if (n > h) n = h;
			gr_dst = gfx_map(x, y);
			gr_rows = n;
			glyph_run();
			h -= n;
			y += n;
		}
		return;
	}
	if (!lut_ok) make_lut();
	for (uint8_t yy = 0; yy < h; yy++, g += bpr) {
		int16_t py = y + yy;
		if (py < b->y || py >= b->y + b->h || (uint16_t)py >= SCREEN_H) continue;
		uint8_t *d = gfx_map(x, py);
		const uint8_t *q = g;
		for (uint8_t xx = 0; xx < w; xx++) {
			uint8_t v = (xx & 1) ? (q[xx >> 1] & 15) : (q[xx >> 1] >> 4);
			int16_t px = x + xx;
			if (v && px >= b->x && px < b->x + b->w && (uint16_t)px < SCREEN_W) d[xx] = lut[v];
		}
	}
}

#define MAX_LINES 24

static char s[1024];
static uint16_t ls[MAX_LINES], le[MAX_LINES];
static int16_t lw[MAX_LINES];
static uint8_t lf[MAX_LINES];

// Разбивка на строки: переводы строк и перенос по словам (Text::processText).
// Возвращает число строк; *maxw — ширина самой длинной.
static uint8_t layout(const tbox_t *b, uint8_t f, int16_t *maxw)
{
	uint8_t nl = 0;
	uint16_t i = 0, start = 0, lastsp = 0xFFFF;
	int16_t w = 0, wAtSp = 0;
	*maxw = 0;
	map_font(f);
	for (;; i++) {
		uint8_t c = (uint8_t)s[i];
		if (c == 0 || c == '\n' || c == 0x02) {
			if (nl < MAX_LINES) { ls[nl] = start; le[nl] = i; lw[nl] = w; lf[nl] = f; nl++; }
			if (w > *maxw) *maxw = w;
			if (!c) break;
			if (c == 0x02) { f = (f == FNT_GEO_BIG) ? FNT_GEO_SMALL : FNT_SMALL; map_font(f); }
			start = i + 1; w = 0; lastsp = 0xFFFF;
			continue;
		}
		if (c == ' ') { lastsp = i; wAtSp = w; }
		w += char_adv(f, c);
		if ((b->flags & TX_WRAP) && w > b->w && lastsp != 0xFFFF && nl < MAX_LINES) {
			ls[nl] = start; le[nl] = lastsp; lw[nl] = wAtSp; lf[nl] = f; nl++;
			if (wAtSp > *maxw) *maxw = wAtSp;
			start = lastsp + 1; i = lastsp; w = 0; lastsp = 0xFFFF;
		}
	}
	return nl;
}

// Высота текста в рамке (Text::getTextHeight), с переходом крупного на мелкий
int16_t text_height(const tbox_t *b, const char *s0)
{
	uint16_t n = 0;
	while (s0[n] && n < sizeof s - 1) { s[n] = s0[n]; n++; }
	s[n] = 0;
	uint8_t bank = get_bank();
	int16_t maxw, th = 0;
	uint8_t nl = layout(b, b->font, &maxw);
	for (uint8_t l = 0; l < nl; l++) th += font_height(lf[l]);
	if (b->font == FNT_BIG && (maxw > b->w || th > b->h) && n && s[n - 1] != '.') {
		nl = layout(b, FNT_SMALL, &maxw);
		th = 0;
		for (uint8_t l = 0; l < nl; l++) th += font_height(lf[l]);
	}
	set_bank(bank);
	return th;
}

void text_draw(const tbox_t *b, const char *s0)
{
	uint16_t n = 0;
	while (s0[n] && n < sizeof s - 1) { s[n] = s0[n]; n++; }
	s[n] = 0;
	uint8_t bank = get_bank(), old3 = pg_win3();

	int16_t maxw;
	uint8_t nl = layout(b, b->font, &maxw);
	int16_t th = 0;
	for (uint8_t l = 0; l < nl; l++) th += font_height(lf[l]);
	// Text::setText: крупный текст, который не влез, выводится мелким (кроме строк на '.')
	if (b->font == FNT_BIG && (maxw > b->w || th > b->h) && n && s[n - 1] != '.') {
		nl = layout(b, FNT_SMALL, &maxw);
		th = 0;
		for (uint8_t l = 0; l < nl; l++) th += font_height(lf[l]);
	}
	int16_t y = b->y;
	if (b->flags & TX_MIDDLE) y += (b->h - th + 1) / 2;
	else if (b->flags & TX_BOTTOM) y += b->h - th;

	uint8_t color = b->color, mul = (b->flags & TX_CONTRAST) ? 3 : 1, mid = (b->flags & TX_INVERT) ? 3 : 0;
	uint8_t f;
	set_lut(color, mul, mid);
	for (uint8_t l = 0; l < nl; l++) {
		f = lf[l];
		if (l && y + font_height(f) > b->y + b->h) break;   // Text: остальное — за краем поля
		map_font(f);
		int16_t x = b->x;
		if (b->flags & TX_CENTER) x += (b->w + font_sp[f] - lw[l] + 1) / 2;
		else if (b->flags & TX_RIGHT) x += b->w - 1 - lw[l];
		for (uint16_t k = ls[l]; k < le[l]; k++) {
			uint8_t c = (uint8_t)s[k];
			if (c == 0x01) {                   // {ALT}: второй цвет и обратно
				color = color == b->color ? b->color2 : b->color;
				set_lut(color, mul, mid);
				continue;
			}
			if (c > ' ' && c != 0x04) draw_glyph(c, x, y, b);
			x += char_adv(f, c);
		}
		y += font_height(f);
	}
	pg_map3(old3);
	set_bank(bank);
}
