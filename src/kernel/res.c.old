// Поиск ресурса по номеру в каталогах пакетов (общий код).
#include <stdint.h>
#include "far.h"
#include "res.h"

extern const uint8_t pack_page[];   // tmp/build/packs.s: первая страница каждого пакета
extern const uint8_t pack_count;

// Последние найденные ресурсы: фон окна и шрифты ищутся на каждой перерисовке.
#define RCACHE 8
static uint16_t rc_id[RCACHE];
static res_t rc_res[RCACHE];
static uint8_t rc_next;

static uint8_t res_scan(uint16_t id, res_t *r);

uint8_t sdres_find(uint16_t id, res_t *r) __banked;   // src/kernel/sdres.c: пакеты на SD

uint8_t res_find(uint16_t id, res_t *r)
{
	for (uint8_t i = 0; i < RCACHE; i++)
		if (rc_id[i] == id && id) { *r = rc_res[i]; return 1; }
	if (!res_scan(id, r)) return sdres_find(id, r);   // с SD — без кэша (слот переиспользуется)
	rc_id[rc_next] = id;
	rc_res[rc_next] = *r;
	rc_next = (rc_next + 1) & (RCACHE - 1);
	return 1;
}

static uint8_t res_scan(uint16_t id, res_t *r)
{
	uint8_t e[16];
	for (uint8_t p = 0; p < pack_count; p++) {
		far_t base = FAR(pack_page[p], 0);
		uint16_t n = far_word(base + 6);
		for (uint16_t i = 0; i < n; i++) {
			far_read(base + 16 + (uint32_t)i * 16, e, 16);
			uint16_t rid = e[0] | (e[1] << 8);
			if (rid != id) continue;
			r->type = e[2];
			r->phys = base + ((uint32_t)(e[4] | (e[5] << 8)) << 9);
			r->size = e[6] | ((uint32_t)e[7] << 8) | ((uint32_t)e[8] << 16) | ((uint32_t)e[9] << 24);
			r->a = e[10] | (e[11] << 8);
			r->b = e[12] | (e[13] << 8);
			r->c = e[14] | (e[15] << 8);
			return 1;
		}
	}
	return 0;
}

uint8_t res_game(void)
{
	return far_byte(FAR(pack_page[0], 5));
}

uint8_t rtab_open(uint16_t id, rtab_t *t)
{
	res_t r;
	if (!res_find(id, &r)) { t->n = 0; return 0; }
	t->base = r.phys;
	t->n = far_word(r.phys);
	t->size = far_word(r.phys + 2);
	t->tail = far_word(r.phys + 4);
	return 1;
}

void rtab_tail(const rtab_t *t, uint16_t off, void *dst, uint16_t bytes)
{
	far_read(t->base + t->tail + off, dst, bytes);
}

void rtab_get(const rtab_t *t, uint16_t i, void *dst)
{
	far_read(t->base + 8 + (uint32_t)i * t->size, dst, t->size);
}

uint16_t rtab_word(const rtab_t *t, uint16_t i, uint8_t off)
{
	return far_word(t->base + 8 + (uint32_t)i * t->size + off);
}
