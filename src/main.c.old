// OpenXComZX: резидентная часть запуска (Win0) — счётчик кадров и кадровое
// прерывание; вся инициализация — boot() в банке 11 (src/kernel/boot.c).
#include <stdint.h>
#include "input.h"

volatile uint16_t frames;
uint8_t input_on;                        // ставит boot() после input_init

// Вызывается из isr_frame (src/kernel/win0/crt0.s).
void frame_isr(void)
{
	frames++;
	if (input_on) input_isr();
}

void boot(void) __banked;

void main(void)
{
	boot();                              // не возвращается (ui_run)
}
