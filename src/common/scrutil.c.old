// Резидентные помощники описаний экранов (Win0): принимают указатели на константы
// банка вызывающего (таблицу экранов, ширины колонок), поэтому не могут жить в чужом
// банке. Кандидаты на ассемблер (14_todo.md §1.3).
#include <stdint.h>
#include <string.h>
#include "scrdef.h"

uint8_t scr_find(const scr_t *t, uint8_t n, uint8_t id, sdef_t *s, wdef_t *w)
{
	for (uint8_t i = 0; i < n; i++)
		if (t[i].id == id) {
			*s = t[i].s;
			memcpy(w, t[i].w, t[i].s.n * sizeof(wdef_t));
			return 1;
		}
	return 0;
}

void list_cols_ext(char *buf, uint8_t n, const uint8_t *w, const uint8_t *align, uint8_t arrows, uint8_t horiz)
{
	buf[0] = (char)n;
	for (uint8_t i = 0; i < n; i++) {
		buf[1 + i] = (char)w[i];
		buf[1 + n + i] = (char)(align ? align[i] : 0);
	}
	buf[1 + 2 * n] = (char)arrows;
	buf[2 + 2 * n] = (char)horiz;
}
